<Project>
	<!--Пакет основных зависимостей библиотеки-->
	<Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />
	<ItemGroup>
		<!--Зависимости тестовых проектов-->
		<PackageVersion Include="coverlet.collector" Version="6.0.2" />
		<PackageVersion Include="EFCore.NamingConventions" Version="9.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageVersion Include="Nito.AsyncEx" Version="5.1.2" />
		<PackageVersion Include="NSubstitute" Version="6.2.0" />
		<PackageVersion Include="Scrutor" Version="7.0.0" />
		<PackageVersion Include="Shouldly" Version="4.3.0" />
		<PackageVersion Include="Testcontainers.Kafka" Version="4.11.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0" />
		<PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>